\examples{
library(nestcolor)

data <- teal_data()
data <- within(data, {
  library(formatters)
  library(dplyr)
  ADSL <- teal.modules.clinical::tmc_ex_adsl
  ADRS <- teal.modules.clinical::tmc_ex_adrs \%>\%
    mutate(AVALC = d_onco_rsp_label(AVALC) \%>\%
      with_label("Character Result/Finding")) \%>\%
    filter(PARAMCD != "OVRINV" | AVISIT == "FOLLOW UP")
})
join_keys(data) <- default_cdisc_join_keys[names(data)]

arm_ref_comp <- list(
  ARM = list(
    ref = "B: Placebo",
    comp = c("A: Drug X", "C: Combination")
  ),
  ARMCD = list(
    ref = "ARM B",
    comp = c("ARM A", "ARM C")
  )
)

app <- init(
  data = data,
  modules = modules(
    tm_g_forest_rsp(
      label = "Forest Response",
      dataname = "ADRS",
      arm_var = variables(c("ARM", "ARMCD"), "ARMCD"),
      arm_ref_comp = arm_ref_comp,
      paramcd = picks(
        variables("PARAMCD", "PARAMCD"),
        values(selected = "INVET", multiple = FALSE),
        check_dataset = FALSE
      ),
      subgroup_var = variables(c("BMRKR2", "SEX"), "BMRKR2", multiple = TRUE),
      strata_var = variables(c("STRATA1", "STRATA2"), "STRATA2", multiple = TRUE),
      plot_height = c(600L, 200L, 2000L),
      default_responses = list(
        BESRSPI = list(
          rsp = c("Stable Disease (SD)", "Not Evaluable (NE)"),
          levels = c(
            "Complete Response (CR)", "Partial Response (PR)", "Stable Disease (SD)",
            "Progressive Disease (PD)", "Not Evaluable (NE)"
          )
        ),
        INVET = list(
          rsp = c("Complete Response (CR)", "Partial Response (PR)"),
          levels = c(
            "Complete Response (CR)", "Not Evaluable (NE)", "Partial Response (PR)",
            "Progressive Disease (PD)", "Stable Disease (SD)"
          )
        ),
        OVRINV = list(
          rsp = c("Progressive Disease (PD)", "Stable Disease (SD)"),
          levels = c("Progressive Disease (PD)", "Stable Disease (SD)", "Not Evaluable (NE)")
        )
      )
    )
  )
)
if (interactive()) {
  shinyApp(app$ui, app$server)
}

}
